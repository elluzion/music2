{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 120,
	"endOfLine": "lf",
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./src/app.css"
	},
	"svelte": {},
	"associations": [
		{
			"files": ["*.svelte"],
			"language": "svelte"
		}
	],
	"ignorePatterns": ["package-lock.json", "pnpm-lock.yaml", "yarn.lock"]
}
